+/// zakura#1080 repro instrumentation. NOT FOR MERGE.
+///
+/// Classifies a `getblocktemplate` withhold by comparing the tip the template was
+/// built for (`info_*`, read from the `NonFinalizedState` watch channel via
+/// `ReadRequest::ChainInfo`) against the best-tip watch channel (`watch`). The two
+/// are published non-atomically in `zakura_state::service::write`, so the height
+/// comparison is what separates an equal-height sideways flip from an ordinary
+/// forward advance.
+fn gbt_withhold_probe(
+    site: &'static str,
+    work_id: Option<&str>,
+    parent: Option<block::Hash>,
+    info_hash: block::Hash,
+    info_height: Height,
+    watch: Option<(Height, block::Hash)>,
+) {
+    let kind = match watch {
+        None => "no_watch_tip",
+        Some((h, _)) if h == info_height => "sideways",
+        Some((h, _)) if h < info_height => "watch_behind",
+        Some(_) => "watch_ahead",
+    };
+
+    metrics::counter!("gbt_withhold.total", "site" => site, "kind" => kind).increment(1);
+    tracing::warn!(
+        target: "gbt_withhold",
+        site,
+        kind,
+        work_id = work_id.unwrap_or("-"),
+        parent = ?parent,
+        info_hash = ?info_hash,
+        info_height = info_height.0,
+        watch_hash = ?watch.map(|(_, h)| h),
+        watch_height = watch.map(|(h, _)| h.0),
+        "getblocktemplate withheld work"
+    );
+}
