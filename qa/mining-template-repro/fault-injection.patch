+/// Lever E fault injection. NOT FOR MERGE.
+///
+/// Returns true while forced rejections remain, counting down from
+/// `GBT_REPRO_FORCE_TEMPLATE_REJECTIONS`. One rejection puts the parent into
+/// fallback-only mode; 64 on a single parent saturate it.
+fn debug_take_forced_template_rejection() -> bool {
+    use std::sync::atomic::{AtomicI64, Ordering};
+    static REMAINING: AtomicI64 = AtomicI64::new(i64::MIN);
+
+    if REMAINING.load(Ordering::Relaxed) == i64::MIN {
+        let configured = std::env::var("GBT_REPRO_FORCE_TEMPLATE_REJECTIONS")
+            .ok()
+            .and_then(|value| value.parse().ok())
+            .unwrap_or(0);
+        let _ = REMAINING.compare_exchange(
+            i64::MIN,
+            configured,
+            Ordering::Relaxed,
+            Ordering::Relaxed,
+        );
+    }
+
+    REMAINING
+        .fetch_update(Ordering::Relaxed, Ordering::Relaxed, |current| {
+            (current > 0).then_some(current - 1)
+        })
+        .is_ok()
+}
