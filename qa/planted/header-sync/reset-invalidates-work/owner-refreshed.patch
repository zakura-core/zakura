+    /// Rewrite `peer`'s ordinary owner to `current`'s generation.
+    pub(super) fn refresh_owner(&mut self, peer: &ZakuraPeerId, current: &EngineSnapshot) {
+        if let Some(request) = self.request_mut(peer) {
+            if let Some(owner) = request.owner.header_owner() {
+                request.owner = HeaderWorkAuthority {
+                    header_generation: current.header_generation,
+                    ..owner.authority
+                }
+                .bind(owner.session_id, owner.request_id)
+                .into();
+            }
+        }
+    }
