+    /// Mutation: the header-best score keeps the selected tip's hash but
+    /// takes its parent's suffix work.
+    pub fn planted_corrupt(&mut self) {
+        let tip = self.metadata.frontiers.header_best;
+        let parent = self.graph.header_node(tip.hash).map(|node| node.parent_hash);
+        if let Some(Ok(score)) = parent.map(|parent| self.graph.header_chain_score(parent)) {
+            self.metadata.header_best_score = crate::ChainScore::new(score.suffix_work, tip.hash);
+        }
+    }
