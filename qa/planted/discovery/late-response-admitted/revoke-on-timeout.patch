+    /// Drops every live query and its reservation, as if the initial wait's
+    /// timeout ended their authority, so a late answer finds no query. The
+    /// requests' exchanges leak instead of dropping, so the connection stays
+    /// open until the late answer comes.
+    pub(super) fn revoke(&self) {
+        let revoked = std::mem::replace(&mut *self.lock(), LiveQueries::new());
+        std::mem::forget(revoked);
+    }
+
