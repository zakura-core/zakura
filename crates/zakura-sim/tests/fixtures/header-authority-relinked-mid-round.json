{
  "node": {
    "main": 3,
    "fork": null
  },
  "mirrors": [
    {
      "chain": {
        "main": 6,
        "fork": null
      },
      "dialer": "mirror"
    }
  ],
  "policy": {
    "base": "success-only",
    "bound_ms": 5000,
    "holds": [
      {
        "select": {
          "kind": "prepare",
          "nth": 1,
          "session": null,
          "held": false
        },
        "until": {
          "count": [
            2,
            {
              "session-admitted": "mirror-0"
            }
          ]
        },
        "then": [
          "engine"
        ],
        "deadline_ms": null
      }
    ]
  },
  "controls": [
    {
      "peer": "mirror-0",
      "action": "relink",
      "when": {
        "submitted": {
          "kind": "prepare",
          "nth": 1,
          "session": null,
          "held": false
        }
      }
    }
  ]
}
