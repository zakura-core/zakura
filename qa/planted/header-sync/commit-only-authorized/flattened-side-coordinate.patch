+    /// Mutation: gives `at` its parent's cumulative work, keeping every
+    /// other field and index.
+    pub(crate) fn planted_flatten_coordinate(&mut self, at: block::Hash) {
+        let parent = self
+            .nodes
+            .get(&at)
+            .and_then(|node| self.nodes.get(&node.parent_hash))
+            .map(|parent| parent.work_coordinate);
+        if let (Some(coordinate), Some(node)) = (parent, self.nodes.get_mut(&at)) {
+            node.work_coordinate = coordinate;
+        }
+    }
