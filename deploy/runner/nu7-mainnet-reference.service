[Unit]
Description=Read-only zcashd chain reference for NU7 activation
Wants=network-online.target
After=network-online.target nu7-mainnet-reference-firewall.service
Requires=nu7-mainnet-reference-firewall.service

[Service]
Type=simple
# The existing zcashd cookie is root-owned and mode 0600. It never leaves this host.
User=root
ExecStart=/usr/bin/python3 /opt/zakura-nu7-reference/nu7_reference.py
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
