+    pub fn planted_corrupt(&mut self) {
+        let selected: Vec<block::Hash> = self
+            .selected_projection
+            .iter()
+            .map(|entry| entry.hash)
+            .collect();
+        let tip = self
+            .selected_projection
+            .last()
+            .and_then(|tip| self.graph.header_node(tip.hash))
+            .map(|node| node.header.clone());
+        let side = self
+            .graph
+            .eligible_header_tips()
+            .into_iter()
+            .find(|tip| !selected.contains(&tip.hash));
+        if let (Some(header), Some(side)) = (tip, side) {
+            self.graph.planted_swap_header(side.hash, header);
+        }
+    }
