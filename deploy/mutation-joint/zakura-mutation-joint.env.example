# /etc/zakura-mutation-joint.env: read by zakura-mutation-joint.service.
ZAKURA_MUTATION_CHECKOUT=/root/mutation-joint/zakura
ZAKURA_MUTATION_STATE=/root/mutation-joint/state
PATH=/root/.cargo/bin:/usr/local/bin:/usr/bin:/bin
CXXFLAGS=-include cstdint
# The routine's budget, then, after `--`, the loop's cases and slots. Each
# search draws 20k runs on each of the 5 default seeds, and fewer on the
# harnesses whose runs take seconds (timing pass, 2026-11-10). The cases are
# mut-7's: every native loop case and the block-sync, block and discovery
# planted cases.
ZAKURA_MUTATION_ARGS=--generate-runs 20000 --harness-runs block-sync/storage=20 --harness-runs discovery/wire=1000 --harness-runs sync/wire=1000 --harness-runs sync/storage=1000 -- --cases qa/native-mutations --planted block-sync/ --planted block/ --planted discovery/ --jobs 4
