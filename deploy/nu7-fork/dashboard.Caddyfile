api.nu7.valargroup.dev {
    encode zstd gzip

    @network_manifest path /v1/network /v1/config
    handle @network_manifest {
        header Access-Control-Allow-Origin https://zakura.com
        header Cache-Control "no-store"
        root * /var/lib/zakura-nu7-public
        @manifest path /v1/network
        rewrite @manifest /network.json
        @config path /v1/config
        rewrite @config /nu7-zakura.toml
        file_server
    }

    handle /snapshots/* {
        root * /mnt/snapshots/nu7-public
        file_server
    }

    @faucet path /v1/faucet/*
    handle @faucet {
        reverse_proxy 127.0.0.1:8094 {
            header_up X-Real-IP {remote_host}
        }
    }

    # zakura-cluster-status answers CORS for its own zakura.com allowlist, including
    # preflight. Only these two paths are public; its fleet page and /data are not.
    @status path /v1/status /healthz
    handle @status {
        reverse_proxy 127.0.0.1:8093
    }

    respond 404
}

nu7.valargroup.dev {
    encode zstd gzip

    # Serve the Sites publication through a public edge that does not challenge
    # link preview clients such as Slackbot.
    reverse_proxy https://zakura-nu7-testnet.akhtariev.chatgpt.site {
        header_up Host zakura-nu7-testnet.akhtariev.chatgpt.site
        # The Sites edge challenges some non-browser user agents. Keep the
        # visitor's user agent at this public edge and use a browser agent
        # only for the upstream request.
        header_up User-Agent "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"
    }
}
