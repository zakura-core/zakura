+    /// Mutation: corrupts the selected projection.
+    pub fn planted_corrupt(&mut self) {
+        // Mutation: the selected projection becomes the whole path to a
+        // held side branch's tip, ancestry intact.
+        let selected: Vec<block::Hash> = self
+            .selected_projection
+            .iter()
+            .map(|entry| entry.hash)
+            .collect();
+        let side = self
+            .graph
+            .eligible_header_tips()
+            .into_iter()
+            .find(|tip| !selected.contains(&tip.hash));
+        if let Some(side) = side {
+            let finalized = self.metadata.frontiers.finalized;
+            let mut path = vec![side];
+            let mut at = side;
+            while at != finalized {
+                let Some(node) = self.graph.header_node(at.hash) else {
+                    break;
+                };
+                let Some(parent) = self.graph.header_node(node.parent_hash) else {
+                    break;
+                };
+                at = crate::Frontier::new(parent.height, parent.hash);
+                path.push(at);
+            }
+            path.reverse();
+            self.selected_projection = path;
+        }
+    }
+
