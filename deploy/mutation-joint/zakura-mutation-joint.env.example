# /etc/zakura-mutation-joint.env: read by zakura-mutation-joint.service.
ZAKURA_MUTATION_CHECKOUT=/root/mutation-joint/zakura
ZAKURA_MUTATION_STATE=/root/mutation-joint/state
PATH=/root/.cargo/bin:/usr/local/bin:/usr/bin:/bin
CXXFLAGS=-include cstdint
# The routine's budget, then, after `--`, the loop's cases and slots. Each
# search draws 20k runs on each of the 5 default seeds, and fewer on the
# harnesses whose runs take seconds (timing pass, 2026-11-10). The cases are
# mut-7's: every native loop case and the block-sync, block and discovery
# planted cases.
# `--planted-shards 7 --planted-targets --sim-targets` checks a seventh of
# the QA store's planted cases each day, directly and through their fuzz
# targets, and each fuzz target on the store's seeds.
# The suite fuzz is off. To turn it on, add `--suite-fuzz` before `--`, which
# fuzzes each suite target for its budget in qa/suite.toml, or
# `--fuzz-seconds <s>`, which sets every target's budget. See README.md.
ZAKURA_MUTATION_ARGS=--planted-shards 7 --planted-targets --sim-targets --generate-runs 20000 --harness-runs block-sync/storage=20 --harness-runs discovery/wire=1000 --harness-runs sync/wire=1000 --harness-runs sync/storage=1000 -- --cases qa/native-mutations --planted block-sync/ --planted block/ --planted discovery/ --jobs 4
# The QA store's Space (scripts/qa_store.py). Add its bucket-scoped key here
# as AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY; never commit it.
ZAKURA_CORPUS_BUCKET=zakura-sim-corpus
ZAKURA_CORPUS_ENDPOINT=https://nyc3.digitaloceanspaces.com
# The daily cleanup's roots and keeps. It deletes cargo target directories,
# the routine's runs and dead campaign build trees that didn't change for 3
# days, and older ones first while the disk is over 80% full. It never
# deletes a --keep path: cargo's and rustup's homes, and the agents'
# worktrees, shared target directory and lock. See README.md.
ZAKURA_CLEANUP_ARGS=--root /root --keep /root/.cargo --keep /root/.rustup --keep /root/pw-* --max-age-days 3 --disk-limit 80
