+    /// Mutation: every header that's already ineligible by a direct reason
+    /// gains a permanent checkpoint conflict too, so it stays excluded after
+    /// its reconsideration.
+    pub fn planted_corrupt(&mut self) {
+        let held: Vec<(block::Hash, block::Height)> = self
+            .graph
+            .header_nodes()
+            .filter(|node| !node.eligibility.direct_reasons.is_empty())
+            .map(|node| (node.hash, node.height))
+            .collect();
+        for (hash, height) in held {
+            let _ = self.graph.add_eligibility_reason(
+                hash,
+                crate::EligibilityReason::CheckpointConflict {
+                    height,
+                    expected: block::Hash([0x5c; 32]),
+                },
+            );
+        }
+    }
+
