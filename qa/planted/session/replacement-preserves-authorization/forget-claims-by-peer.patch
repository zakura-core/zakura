+    /// Detach the peer's claims for the caller to drop after unlocking,
+    /// whichever routine generation owns its entry.
+    pub(super) fn forget_outstanding(
+        &mut self,
+        peer: &ZakuraPeerId,
+    ) -> Option<BTreeMap<block::Height, OutstandingMeta>> {
+        self.peers
+            .get_mut(peer)
+            .map(|entry| std::mem::take(&mut entry.outstanding))
+    }
