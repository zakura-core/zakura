+    /// Mutation: a header that inherits ineligibility names the finalized
+    /// anchor as its source instead of its ineligible parent, so it stays
+    /// ineligible with the wrong source.
+    pub fn planted_corrupt(&mut self) {
+        let anchor = self.metadata.frontiers.finalized.hash;
+        let wrong: Vec<block::Hash> = self
+            .graph
+            .header_nodes()
+            .filter(|node| node.eligibility.inherited_from.is_some())
+            .map(|node| node.hash)
+            .collect();
+        for hash in wrong {
+            self.graph.planted_inherit(hash, anchor);
+        }
+    }
