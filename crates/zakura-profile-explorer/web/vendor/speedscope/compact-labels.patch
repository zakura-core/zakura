+// Display only. Frame keys, search, exports and inspection keep the full symbol.
+export function compactFrame(name: string): string {
+  const symbol = name.replace(/ \(.*\)$/, '').replace(/::h[0-9a-f]{16}$/, '')
+  const qualified = symbol.startsWith('<')
+  const visibleDepth = qualified ? 1 : 0
+  let compact = '', depth = 0
+  for (const char of symbol) {
+    if (char === '<') {
+      if (depth === visibleDepth) compact += '<…>'
+      else if (qualified && depth === 0) compact += '<'
+      depth++
+    } else if (char === '>' && depth > 0) {
+      depth--
+      if (qualified && depth === 0) compact += '>'
+    } else if (depth <= visibleDepth) compact += char
+  }
+  if (qualified) return compact
+  const parts = compact.split('::')
+  return parts.length > 4 ? parts[0] + '::…::' + parts.slice(-3).join('::') : compact
+}
