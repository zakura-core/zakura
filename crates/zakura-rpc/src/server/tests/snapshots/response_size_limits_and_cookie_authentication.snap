[{"jsonrpc":"2.0","method":"getstandardfee","params":[],"id":1},{"jsonrpc":"2.0","method":"rpc.discover","params":[],"id":2}]
---
HTTP/1.1 200 OK
content-type: application/json; charset=utf-8
connection: close
content-length: 184

[{"jsonrpc":"2.0","id":1,"result":{"standard_fee":400,"version":0}},{"jsonrpc":"2.0","id":2,"error":{"code":-32008,"message":"Response is too big","data":"Exceeded max limit of 300"}}]

