[Unit]
Description=NU7 fork validating node
After=network-online.target
Wants=network-online.target
AssertPathExists=/usr/local/bin/zakurad

[Service]
Type=simple
ExecStart=/usr/local/bin/zakurad -c /etc/zakura/zakura.toml start
Restart=always
RestartSec=5
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
