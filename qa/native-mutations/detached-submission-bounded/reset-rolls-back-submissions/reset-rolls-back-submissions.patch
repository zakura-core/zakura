diff --git a/crates/zakura-network/src/zakura/block_sync/sequencer_task/state.rs b/crates/zakura-network/src/zakura/block_sync/sequencer_task/state.rs
index dd7a39f803..08a4106c04 100644
--- a/crates/zakura-network/src/zakura/block_sync/sequencer_task/state.rs
+++ b/crates/zakura-network/src/zakura/block_sync/sequencer_task/state.rs
@@ -596,6 +596,17 @@ impl SequencerState {
         keep_submitted_applies: bool,
         operations: &mut Vec<SequencerOperation>,
     ) {
+        // Roll back every dispatched body above `tip`, as a refused dispatch
+        // does: the reset retires its work, so no holder needs it.
+        for height in (tip.0.saturating_add(1))..=self.sequencer.floor().0 {
+            let height = block::Height(height);
+            // An unsubmitted body carries token 0.
+            if let Some((_, _, token, _)) = self.sequencer.applying_identity(height) {
+                if token != 0 {
+                    self.sequencer.unsubmit(height, token);
+                }
+            }
+        }
         let _ = self.sequencer.reset_to(tip, keep_submitted_applies);
         operations.push(SequencerOperation::ResetWorkAbove(tip));
         self.reset_epoch = self.reset_epoch.saturating_add(1);
