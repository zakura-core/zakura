+    /// Mutation: the apply's new selected tip is stored deferred for a
+    /// day past its time, with eligibility recomputed to match, though the
+    /// clock admits it now.
+    pub fn planted_corrupt(&mut self) {
+        let tip = self.metadata.frontiers.header_best;
+        let time = self.graph.header_node(tip.hash).map(|node| node.header.time);
+        if let Some(time) = time {
+            let _ = self.graph.set_header_validation_state(
+                tip.hash,
+                crate::HeaderValidationState::DeferredUntil(time + chrono::Duration::days(1)),
+            );
+        }
+    }
