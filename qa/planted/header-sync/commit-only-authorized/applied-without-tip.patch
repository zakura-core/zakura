+    /// Mutation: the apply's new selected tip is removed again, with the
+    /// projection, frontier, score and preference moved to its parent, so
+    /// the apply reports `Applied` without holding its last header.
+    pub fn planted_corrupt(&mut self) {
+        let tip = self.metadata.frontiers.header_best;
+        if self.selected_projection.len() < 2 || self.graph.remove_header_leaf(tip.hash).is_err() {
+            return;
+        }
+        self.selected_projection.pop();
+        let parent = *self.selected_projection.last().expect("the projection kept its anchor");
+        self.metadata.frontiers.header_best = parent;
+        if let Ok(score) = self.graph.header_chain_score(parent.hash) {
+            self.metadata.header_best_score = score;
+        }
+        self.graph.prefer_header_tip(Some(parent));
+    }
+
