# /etc/zakura-mutation-joint.env: read by zakura-mutation-joint.service.
ZAKURA_MUTATION_CHECKOUT=/root/mutation-joint/zakura
ZAKURA_MUTATION_STATE=/root/mutation-joint/state
PATH=/root/.cargo/bin:/usr/local/bin:/usr/bin:/bin
CXXFLAGS=-include cstdint
# The routine's budget: 5 seeds and 20k runs by default, with a smaller count
# for the harnesses whose runs take seconds (timing pass, 2026-11-10).
ZAKURA_MUTATION_ARGS=--generate-runs 20000 --harness-runs block-sync/storage=20 --harness-runs discovery/wire=1000 --harness-runs sync/wire=1000 --harness-runs sync/storage=1000
