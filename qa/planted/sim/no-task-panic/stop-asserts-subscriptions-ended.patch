@@ -425,6 +425,12 @@ impl PublisherState {
 
     /// Stop the publisher for `exit`, keeping the first reason.
     fn stop(&mut self, exit: Exit) -> Exit {
+        // Mutation: a stop assumes every subscription already ended, which
+        // a subscriber that leaves mid-subscription breaks.
+        assert!(
+            self.subscriptions.is_empty(),
+            "a publisher stops only after its subscriptions end"
+        );
         *self.exit.get_or_insert(exit)
     }
 
