+    /// Mutation: the lowest held side header, by height then hash, is
+    /// marked deferred for a day, with its eligibility recomputed to match.
+    pub fn planted_corrupt(&mut self) {
+        let selected: Vec<block::Hash> = self
+            .selected_projection
+            .iter()
+            .map(|entry| entry.hash)
+            .collect();
+        let side = self
+            .graph
+            .header_nodes()
+            .filter(|node| !selected.contains(&node.hash) && node.validation == crate::HeaderValidationState::Valid).min_by_key(|node| (node.height, node.hash.0))
+            .map(|node| (node.hash, node.header.time));
+        if let Some((hash, time)) = side {
+            let _ = self.graph.set_header_validation_state(
+                hash,
+                crate::HeaderValidationState::DeferredUntil(time + chrono::Duration::days(1)),
+            );
+        }
+    }
